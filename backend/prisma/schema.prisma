generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         GlobalRole @default(USER)
  createdAt    DateTime @default(now())

  ledProjects      Project[]       @relation("ProjectLead")
  projectMembers   ProjectMember[]
  reportedIssues   Issue[]         @relation("ReportedIssues")
  assignedIssues   Issue[]         @relation("AssignedIssues")
  comments         Comment[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  leadId       String
  lead         User     @relation("ProjectLead", fields: [leadId], references: [id])
  issueCounter Int      @default(0)
  createdAt    DateTime @default(now())

  members  ProjectMember[]
  statuses Status[]
  issues   Issue[]
}

model ProjectMember {
  projectId String
  userId    String
  role      Role    @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Status {
  id        String         @id @default(uuid())
  projectId String
  name      String
  category  StatusCategory
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
}

model Issue {
  id          String    @id @default(uuid())
  projectId   String
  key         String    @unique
  type        IssueType
  title       String
  description String?
  statusId    String
  assigneeId  String?
  reporterId  String
  priority    Priority  @default(MEDIUM)
  epicId      String?
  parentId    String?
  sprintId    String?
  storyPoints Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status   Status  @relation(fields: [statusId], references: [id])
  assignee User?   @relation("AssignedIssues", fields: [assigneeId], references: [id])
  reporter User    @relation("ReportedIssues", fields: [reporterId], references: [id])

  epic     Issue?  @relation("EpicChildren", fields: [epicId], references: [id])
  children Issue[] @relation("EpicChildren")

  parent   Issue?  @relation("SubtaskParent", fields: [parentId], references: [id])
  subtasks Issue[] @relation("SubtaskParent")

  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}
